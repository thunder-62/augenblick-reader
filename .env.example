# Augenblick – Konfiguration (Vorlage). Echte Werte nur in .env bzw. /etc/augenblick/augenblick.env, nie im Repo.

# --- Server ---------------------------------------------------------------
# Adresse und Port der API/Web-App. Auf dem Pi 0.0.0.0, damit das Tablet sie erreicht.
HOST=127.0.0.1
PORT=8080
# Datenverzeichnis (SQLite). Auf dem Pi: /var/lib/augenblick
AUGENBLICK_DATA_DIR=./data

# --- Quellen --------------------------------------------------------------
# BR24-Feed für die Region (siehe docs/entscheidungen/002-br24-feeds.md)
BR24_FEED_URL=https://feeds.br24.de/rss/nachrichten
# tagesschau-Schnittstelle; höchstens 60 Abrufe pro Stunde erlaubt, Augenblick nutzt höchstens 50
TAGESSCHAU_BASE_URL=https://www.tagesschau.de/api2u
TAGESSCHAU_HOURLY_LIMIT=50
# Höchstens so viele neue Artikel je Quelle und Lauf abholen
AUGENBLICK_MAX_ARTICLES_PER_RUN=20
# Beim Start des Workers sofort einmal abholen
AUGENBLICK_FETCH_ON_START=true
# Artikel löschen nach so vielen Tagen
AUGENBLICK_RETENTION_DAYS=7

# --- Darstellung: Anfangswerte, bis im Admin-Bereich etwas gespeichert ist ----
# dark (gebrochenes Weiß auf Schwarz) oder light (fast Schwarz auf Creme)
AUGENBLICK_THEME=dark
# Schriftgröße in CSS-Pixeln, mindestens 24 (= 18 pt)
AUGENBLICK_FONT_SIZE_PX=30
# Rubriken-Mix: name=rubrik1,rubrik2:anzahl; … (Standard siehe SPEC §5.2)
# AUGENBLICK_SECTIONS=region=region:4;welt=inland,ausland,wirtschaft:4;vermischtes=vermischtes,wissen,kultur:2;sport=sport:2

# --- Admin-Bereich (/admin) ---------------------------------------------------
# PIN für den Admin-Bereich, mindestens 4 Ziffern. Ohne PIN bleibt der Admin-Bereich gesperrt.
AUGENBLICK_ADMIN_PIN=
# Netze, aus denen /admin erreichbar ist (CIDR, kommagetrennt). Standard: dieses Gerät und Tailscale.
# AUGENBLICK_ADMIN_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48
# Nutzungsprotokoll nach so vielen Tagen löschen
AUGENBLICK_USAGE_RETENTION_DAYS=180

# --- Updates (deploy/update.sh) ----------------------------------------------
# GitHub-Repository, aus dem Releases geladen werden
AUGENBLICK_REPO=thunder-62/augenblick-reader
