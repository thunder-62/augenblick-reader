[Unit]
Description=Augenblick API (Web-App und JSON-API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=augenblick
Group=augenblick
WorkingDirectory=/opt/augenblick/current
EnvironmentFile=/etc/augenblick/augenblick.env
Environment=NODE_ENV=production
Environment=AUGENBLICK_WEB_DIST=/opt/augenblick/current/web/dist
# Node aus dem Systempfad (/usr/local/bin vor /usr/bin), ADR 015
ExecStart=/usr/bin/env node server/dist/api.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/augenblick

[Install]
WantedBy=multi-user.target
